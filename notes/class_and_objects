/*** CLASSES ***/

A car is an 'object'
the car has 'attributes' like weight and color
it performs 'methods' like drive and brake

'Attributes and Methods' are basically 'variables and functions' that belong to a 'class' (they are also often referred to as 'class members')
When variables are declared in a class, they are called 'attributes'

A 'Class' is a user-defined data type that the program uses, and it works as an object constructor.


//Example Class

class MyClass {        // The class
  public:              // Access specifier
    int myNum;         // Attribute (int variable)
    string myString;   // Attribute (string variable)
};



/*** OBJECTS ***/

'Objects' are created *from* 'Classes'


//Example Object

class MyClass {        // The class
  public:              // Access specifier
    int myNum;         // Attribute (int variable)
    string myString;   // Attribute (string variable)
};

int main() {
  MyClass myObj;     // create an object from MyClass

  // Access attriutes and set values
  myObj.myNum = 15;
  myObj.myString = "Some text";

  // Print attribute values
  cout << myObj.myNum << "\n";
  cout << myObj.myString;
  return 0;
}


//Example Objects

class Car {
  public:
    string brand;   
    string model;
    int year;
};

int main() {
  // Create an object of Car
  Car carObj1;
  carObj1.brand = "BMW";
  carObj1.model = "X5";
  carObj1.year = 1999;

  // Create another object of Car
  Car carObj2;
  carObj2.brand = "Ford";
  carObj2.model = "Mustang";
  carObj2.year = 1969;

  // Print attribute values
  cout << carObj1.brand << " " << carObj1.model << " " << carObj1.year << "\n";
  cout << carObj2.brand << " " << carObj2.model << " " << carObj2.year << "\n";
  return 0;
}
