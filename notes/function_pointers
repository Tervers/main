#include <stdio.h>

// A function that adds two integers
int add(int a, int b) {
    return a + b;
}

// A function that subtracts two integers
int subtract(int a, int b) {
    return a - b;
}

int main() {
    // Declare a function pointer named 'op_ptr' that points to functions
    // taking two integers and returning an integer.
    int (*op_ptr)(int, int); 

    // Assign the address of the 'add' function to 'op_ptr'
    op_ptr = &add; // Or simply: op_ptr = add;

    // Call the function through the pointer
    printf("Addition: %d\n", op_ptr(10, 5)); // Output: 15

    // Assign the address of the 'subtract' function to 'op_ptr'
    op_ptr = &subtract; // Or simply: op_ptr = subtract;

    // Call the function through the pointer
    printf("Subtraction: %d\n", op_ptr(10, 5)); // Output: 5

    return 0;
}
